{
  "name": "partner-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "cms",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:cms": "npm run dev --workspace=cms",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:cms\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
